# API Configuration
PROJECT_NAME="Meeting Intelligence API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database (MySQL on localhost; use sqlite:///./sql_app.db for SQLite)
DATABASE_URL="mysql+pymysql://root:@127.0.0.1:3306/meeting_intel?charset=utf8mb4"
SECRET_KEY="dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Transcription Providers
# Local Faster Whisper
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# Cloud Deepgram (for public audio)
DEEPGRAM_API_KEY=""

# LLM Synthesis (LiteLLM)
LITELLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

