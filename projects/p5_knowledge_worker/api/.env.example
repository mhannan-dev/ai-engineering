ENVIRONMENT="development"

# Defaults to SQLite at ../data/knowledge_worker.db
# DATABASE_URL="sqlite:///E:/path/to/knowledge_worker.db"

# Empty = embedded Qdrant under ../data/qdrant (single process, no Docker needed).
# Set to use the server from docker-compose.yml:
# QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION="chunks_e5_large"

# Multilingual (English + Bangla) dense embeddings, run locally on CPU via fastembed.
# Changing the model requires a new QDRANT_COLLECTION and re-indexing every document.
EMBEDDING_MODEL="intfloat/multilingual-e5-large"
EMBEDDING_DIM=1024

CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
UPLOAD_MAX_BYTES=26214400
